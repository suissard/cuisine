{
  "kind": "collectionType",
  "collectionName": "recettes",
  "info": {
    "singularName": "recette",
    "pluralName": "recettes",
    "displayName": "Recette",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "origine": {
      "type": "string"
    },
    "portions": {
      "type": "string"
    },
    "degustation": {
      "type": "enumeration",
      "enum": [
        "Froid",
        "Chaud",
        "Tiède",
        "Ambiant"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::categorie-plat.categorie-plat",
      "inversedBy": "recettes"
    },
    "materiel_global": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::materiel.materiel",
      "inversedBy": "recettes"
    },
    "difficulte": {
      "type": "component",
      "repeatable": false,
      "component": "meta.difficulte"
    },
    "ingredients": {
      "type": "component",
      "repeatable": true,
      "component": "recette.recette-ingredient"
    },
    "etapes": {
      "type": "component",
      "repeatable": true,
      "component": "recette.etape"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
